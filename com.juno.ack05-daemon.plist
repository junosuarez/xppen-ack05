<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.juno.ack05-daemon</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/ack05-daemon</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/ack05-daemon.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/ack05-daemon.stderr.log</string>
</dict>
</plist>
